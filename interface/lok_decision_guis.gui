	containerWindowType = {
		name = "TAI_noble_houses_decision_window"
		size = { width=800 height=1000 }
		containerWindowType = {
			name = "TAI_unlocked_noble_houses_list_container"
			Orientation = upper_left
			size = {width=525 height=1000}
			position = {x=-10 y=0}
			verticalScrollbar = "right_vertical_slider_intel"
			scroll_wheel_factor = 40
			smooth_scrolling = yes
					
			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}
			
			gridBoxType = {
				name = "TAI_unlocked_noble_houses_list"
				position = { x = 50 y = 0 }
				#The size of the gridbox
				size = { width = 100%% height = 100%% }
				Orientation = upper_left
				#The slot size
				slotsize = {width=250 height=100 }
				format = "UPPER_LEFT"
				#the maximum horizontal gui elements
				max_slots_horizontal = 2
				#the maximum vertical gui elements
				max_slots_vertical = 11
			}
		}
	}

