spriteTypes = {
    # 	Guide to Sprite Formatting (yw elo)
    # 	TAG - Country Tag, self explanatory
    #	NAME - Name of the character, capitalised
    #	spriteType = { name = "GFX_portrait_TAG_NAME" 	DO THE TABS OR ELSE		texturefile = "gfx/leaders/TAG/TAG_NAME.tga" <-- use TGA for conistency		}
    # 	spriteType = { name = "GFX_portrait_TAG_NAME_Small" 	For Advisors	texturefile = "gfx/interface/ministers/TAG/TAG_Name.tga < --- Same name		}
    #
    #	Somewhat Empty Format for you to copy past
    spriteType = { name = "GFX_portrait_"									texturefile = "gfx/leaders/REPLACE/REPLACE.tga"								}
    spriteType = { name = "GFX_portrait__Small"								texturefile = "gfx/interface/ministers/REPLACE/REPLACE.tga"					}
